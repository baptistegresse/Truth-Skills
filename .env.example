# Copy to .env and fill in. Never commit .env.

# World ID app (Developer Portal)
WORLD_APP_ID=app_xxxxxxxxxxxxxxxx
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
# RP signing key, shown once in the portal. Server-side only.
WORLD_SIGNING_KEY=
# production | staging | sandbox
WORLD_ENVIRONMENT=sandbox
# Credentials accepted at sign-in (any of them), comma-separated
WORLD_CREDENTIALS=proof_of_human,selfie
# true only to enroll a new sandbox tester
WORLD_INVITE_CODE=false
# Written by `npm run staging:open`; leave empty
WORLD_STAGING_TOKEN=

# Neon Postgres (the pooled connection string works as is, migrations included)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/truth-skills?sslmode=require

# Signs access tokens: openssl rand -hex 32
JWT_SECRET=

# Issuer URL and base of every link; must be https in production
PUBLIC_URL=http://localhost:3000
PORT=3000
